<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <AssemblyName>the_spreadsheet_edmund_hates</AssemblyName> 
  </PropertyGroup>
  <ItemGroup>
      <IgnoresAccessChecksTo Include="MewgenicsModSdk" />
  </ItemGroup>
  <ItemGroup>
    <!-- Vortice.Windows — D3D11, D2D1, DWrite, DXGI for the DX hook overlay -->
    <PackageReference Include="IgnoresAccessChecksToGenerator" Version="0.8.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    
    <PackageReference Include="Vortice.Direct3D11" Version="3.*" />
    <PackageReference Include="Vortice.Direct2D1" Version="3.*" />
    <PackageReference Include="Vortice.Mathematics" Version="2.*" />
  </ItemGroup>
</Project>