        } else
        {
            LogStr($"[HOOK] RegisterCallbackHook: Should never reach here");
        }
        // LogStr($"[HOOK] RegisterCallbackHook: menuPanel=0x{a1:X}, a2=0x{a2:X}, a3=0x{a3:X}, a4=0x{a4:X}");
        return result;
    }

   

